# Checks an SPDX fragment against the files it describes: each listed file's SHA-256 as on disk,
# and with COMPLETE every file under BASE listed (but the fragment itself).
#
#   cmake -DSPDX=<fragment> -DBASE=<dir> [-DCOMPLETE=ON] -P tools/check_spdx.cmake
cmake_minimum_required(VERSION 3.21)

if(NOT SPDX OR NOT BASE)
    message(FATAL_ERROR "usage: cmake -DSPDX=<fragment> -DBASE=<dir> [-DCOMPLETE=ON] -P tools/check_spdx.cmake")
endif()
file(READ "${SPDX}" _doc)
string(JSON _count LENGTH "${_doc}" files)
math(EXPR _last "${_count} - 1")
set(_listed "")
foreach(_i RANGE ${_last})
    string(JSON _name GET "${_doc}" files ${_i} fileName)
    string(REGEX REPLACE "^\\./" "" _name "${_name}")
    string(JSON _sha256 GET "${_doc}" files ${_i} checksums 1 checksumValue)
    if(NOT EXISTS "${BASE}/${_name}")
        message(FATAL_ERROR "${SPDX}: ${_name} is listed but missing")
    endif()
    file(SHA256 "${BASE}/${_name}" _actual)
    if(NOT _actual STREQUAL _sha256)
        message(FATAL_ERROR "${SPDX}: ${_name} differs from its checksum")
    endif()
    list(APPEND _listed "${_name}")
endforeach()
if(COMPLETE)
    get_filename_component(_self "${SPDX}" ABSOLUTE)
    file(GLOB_RECURSE _files RELATIVE "${BASE}" "${BASE}/*")
    foreach(_file IN LISTS _files)
        get_filename_component(_abs "${BASE}/${_file}" ABSOLUTE)
        if(NOT _abs STREQUAL _self AND NOT _file IN_LIST _listed)
            message(FATAL_ERROR "${SPDX}: ${_file} is not listed")
        endif()
    endforeach()
endif()
message(STATUS "${SPDX}: ${_count} files, checksums as on disk")
