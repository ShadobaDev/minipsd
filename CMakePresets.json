{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "msvc",
      "displayName": "Windows · MSVC (VS 2022)",
      "inherits": "windows",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" }
    },
    {
      "name": "mingw",
      "displayName": "Windows · MinGW GCC (MSYS2, on PATH)",
      "inherits": "windows",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux · GCC",
      "inherits": "linux",
      "cacheVariables": { "CMAKE_C_COMPILER": "gcc", "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux · Clang",
      "inherits": "linux",
      "cacheVariables": { "CMAKE_C_COMPILER": "clang", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux · GCC + AddressSanitizer/UBSan",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux · Clang + ThreadSanitizer",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    },
    {
      "name": "linux-fuzz",
      "displayName": "Linux · Clang + libFuzzer, AddressSanitizer/UBSan (local only)",
      "inherits": "linux-clang",
      "cacheVariables": {
        "MINIPSD_FUZZ": "ON",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-tidy",
      "displayName": "Linux · Clang + clang-tidy (.clang-tidy)",
      "inherits": "linux-clang",
      "cacheVariables": { "MINIPSD_CLANG_TIDY": "clang-tidy" }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux · GCC + coverage (gcovr)",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "--coverage -fprofile-update=atomic",
        "CMAKE_CXX_FLAGS": "--coverage -fprofile-update=atomic",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_SHARED_LINKER_FLAGS": "--coverage",
        "MINIPSD_TEST_FIXTURES": "OFF"
      }
    }
  ],

  "buildPresets": [
    { "name": "msvc",        "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "mingw",       "configurePreset": "mingw" },
    { "name": "linux-gcc",   "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "configurePreset": "linux-clang" },
    { "name": "linux-asan",     "configurePreset": "linux-asan" },
    { "name": "linux-tidy",     "configurePreset": "linux-tidy" },
    { "name": "linux-tsan",     "configurePreset": "linux-tsan" },
    { "name": "linux-fuzz",     "configurePreset": "linux-fuzz" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage" }
  ],

  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "msvc",        "inherits": "base", "configurePreset": "msvc", "configuration": "Debug" },
    { "name": "mingw",       "inherits": "base", "configurePreset": "mingw" },
    { "name": "linux-gcc",   "inherits": "base", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "inherits": "base", "configurePreset": "linux-clang" },
    { "name": "linux-asan",     "inherits": "base", "configurePreset": "linux-asan" },
    { "name": "linux-tidy",     "inherits": "base", "configurePreset": "linux-tidy" },
    { "name": "linux-tsan",     "inherits": "base", "configurePreset": "linux-tsan" },
    { "name": "linux-fuzz",     "inherits": "base", "configurePreset": "linux-fuzz" },
    { "name": "linux-coverage", "inherits": "base", "configurePreset": "linux-coverage" }
  ]
}
